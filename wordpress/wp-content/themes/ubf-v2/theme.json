{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "navy", "name": "Deep Navy", "color": "#0B3654" },
        { "slug": "blue", "name": "Interactive Blue", "color": "#2E6F94" },
        { "slug": "ink", "name": "Ink", "color": "#10232D" },
        { "slug": "paper", "name": "Warm Paper", "color": "#F7F4EE" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "neutral", "name": "Neutral", "color": "#E8EDF0" },
        { "slug": "stone", "name": "Stone", "color": "#D7C5AC" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "name": "4", "size": "4px" },
        { "slug": "20", "name": "8", "size": "8px" },
        { "slug": "30", "name": "12", "size": "12px" },
        { "slug": "40", "name": "16", "size": "16px" },
        { "slug": "50", "name": "24", "size": "24px" },
        { "slug": "60", "name": "32", "size": "32px" },
        { "slug": "70", "name": "48", "size": "48px" },
        { "slug": "80", "name": "64", "size": "64px" },
        { "slug": "90", "name": "96", "size": "96px" },
        { "slug": "100", "name": "128", "size": "128px" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Source Sans 3",
          "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "serif",
          "name": "Source Serif 4",
          "fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "XS", "size": "0.8125rem" },
        { "slug": "sm", "name": "Small", "size": "0.9375rem" },
        { "slug": "md", "name": "Body", "size": "1.125rem" },
        { "slug": "lg", "name": "Lead", "size": "1.375rem" },
        { "slug": "xl", "name": "H3", "size": "clamp(1.75rem, 3vw, 2.25rem)" },
        { "slug": "2-xl", "name": "H2", "size": "clamp(2.25rem, 4vw, 3.25rem)" },
        { "slug": "3-xl", "name": "H1", "size": "clamp(2.5rem, 5vw, 4rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|50",
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|md",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "3px"
        },
        "color": {
          "background": "var:preset|color|navy",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "700"
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|blue"
        },
        "typography": {
          "fontSize": "var:preset|font-size|sm"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|navy"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "600",
          "lineHeight": "1.08"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|blue"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "var:preset|spacing|50"
        }
      },
      "core/quote": {
        "border": {
          "color": "var:preset|color|stone",
          "style": "solid",
          "width": "0 0 0 4px"
        },
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|50"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
